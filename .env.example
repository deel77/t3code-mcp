# Copy to .env for local use. Keep credentials outside the checkout.
# Load with: node --env-file=.env src/index.mjs
T3_BASE_URL=http://127.0.0.1:3773
T3_TOKEN_FILE=/var/lib/t3code-mcp/token
T3_MCP_HOST=127.0.0.1
T3_MCP_PORT=3993
CF_ACCESS_TEAM_DOMAIN=https://example-team.cloudflareaccess.com
CF_ACCESS_AUD=REPLACE_WITH_64_CHARACTER_AUDIENCE_TAG
CF_ACCESS_ALLOWED_EMAIL=person@example.com
# T3_BINARY=/absolute/path/to/t3
